# ОБЯЗАТЕЛЬНО: общий секрет с arm_voip (VOICE_SERVICE_TOKEN там же)
VOICE_SERVICE_TOKEN=CHANGE_ME

# -- TTS (Piper) - см. download_models.sh
TTS_VOICES_DIR=/models/piper
TTS_DEFAULT_VOICE=ru_RU-irina-medium
TTS_MAX_CHARS=600

# -- STT (faster-whisper) - см. download_models.sh
STT_MODEL_DIR=/models/whisper
# tiny/base/small/medium: чем крупнее, тем точнее и медленнее на CPU
STT_MODEL_SIZE=small
STT_LANGUAGE=ru
STT_COMPUTE_TYPE=int8
STT_THREADS=4

# прогреть модели при старте контейнера (первый вызов иначе медленный)
VOICE_WARM_UP=1
