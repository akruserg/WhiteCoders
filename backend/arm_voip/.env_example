# Сервис arm_voip и Asterisk читают один и тот же файл .env

# -- Asterisk ARI
ARI_BASE_URL=http://asterisk:8088/ari
ARI_USERNAME=arm_voip
# ОБЯЗАТЕЛЬНО: пароль ARI, подставляется в ari.conf при старте Asterisk
ARI_PASSWORD=CHANGE_ME
ARI_APP_NAME=arm_voip
ARI_TIMEOUT_SEC=5

# -- доступ arm_api <-> arm_voip
# ОБЯЗАТЕЛЬНО: тот же токен, что ARM_VOIP_SERVICE_TOKEN в .env сервиса arm_api
ARM_VOIP_SERVICE_TOKEN=CHANGE_ME
ARM_API_URL=http://arm_api:5000/api/v1

# -- SIP-номера операторов
# ОБЯЗАТЕЛЬНО: секрет, из которого выводятся пароли номеров
VOIP_SIP_SECRET=CHANGE_ME
# сколько звонков одновременно (по одному SIP-номеру на звонок)
VOIP_POOL_SIZE=20
VOIP_POOL_START=2001
# webrtc - браузерный софтфон, sip - аппаратный IP-телефон по UDP
VOIP_ENDPOINT_MODE=webrtc
# адрес, по которому браузер обращается к Asterisk: через прокси wss://<хост>/ws
# (на localhost без прокси допустим ws://localhost:8088/ws)
SIP_WS_URL=wss://localhost/ws
SIP_DOMAIN=localhost

# -- поведение звонка
VOIP_DIALPLAN_CONTEXT=arm112
VOIP_RING_TIMEOUT_SEC=30
VOIP_MAX_CALL_SEC=900
# требование ТЗ: задержка голоса не более 150 мс
VOIP_MAX_LATENCY_MS=150
# необязательно: звонить всегда на один номер (стенд с одним аппаратом), без пула
# VOIP_DESTINATION=1001

# -- голосовой диалог с ИИ-заявителем (сервис voice, профиль ai)
# речь оператора -> распознавание (STT) -> нейросеть (arm_api) -> синтез (TTS) -> в VoIP
# DEFAULT: 0
VOICE_DIALOG_ENABLED=0
VOICE_BASE_URL=http://voice:8090
# ОБЯЗАТЕЛЬНО (если включено): тот же токен, что VOICE_SERVICE_TOKEN в voice/.env
VOICE_SERVICE_TOKEN=CHANGE_ME
TTS_DEFAULT_VOICE=ru_RU-irina-medium
# диалог обрывается после стольких реплик оператора (карточку можно
# дозаполнить и без диалога - это не блокирует занятие)
VOICE_DIALOG_MAX_TURNS=6
VOICE_MAX_SILENCE_SEC=2
VOICE_MAX_UTTERANCE_SEC=20
